# Fireworks AI key (e.g. "mcp-..." or "fw_...")
FIREWORKS_API_KEY=YOUR_FIREWORKS_API_KEY

# Optional: override the Fireworks model id (defaults to GLM 5.3 Flash)
# FIREWORKS_MODEL_ID=accounts/fireworks/models/glm-5p3-flash

# Optional: override the API base (used for testing with a mock/proxy)
# FIREWORKS_API_URL=https://api.fireworks.ai/inference/v1/chat/completions
